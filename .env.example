# Optional. You can also paste the key in the Lumen UI.
# Get a free key at https://www.themoviedb.org/settings/api
# v3 API key or v4 Read Access Token (starts with eyJ) both work.
VITE_TMDB_API_KEY=
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w780
# Example: https://your-authorized-embed-provider.example/embed/movie/{tmdbId}
VIDSRC_EMBED_URL_TEMPLATE=
TMDB_DEFAULT_REGION=US
